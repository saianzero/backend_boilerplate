# Copy to .env and fill in. Every key is read in src/core/config.py.

# ---- App ----
APP_NAME=backend-service
ROOT_PATH=
TOOL_ENV=dev                       # dev | staging | prod (prod hides /docs)
BACKEND_CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- Datastores ----
DATABASE_URI=mongodb://localhost:27017
DATABASE_NAME=backend_service
REDIS_CACHE_URL=redis://localhost:6379/0

# ---- Task queue (NATS JetStream) ----
NATS_SERVER_HOST=localhost:4222
NATS_STREAM_NAME=BACKEND_JS1

# ---- Auth platform ----
AUTH_SERVICE_URL=http://localhost:8001
WEBHOOK_SHARED_SECRET=change-me
PLATFORM_ORG_ID=

# ---- Object storage ----
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=my-bucket
S3_BUCKET_REGION=ap-south-1
PRESIGNED_URL_EXPIRY_SECONDS=3600

# ---- Email ----
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
SENDER_EMAIL=noreply@example.com

# ---- LLM providers ----
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_DAILY_LIMIT=1000
DEFAULT_LLM_MODEL=gemini-3-flash-preview

# ---- Observability ----
OTEL_ENABLED=False
OTEL_ENDPOINT=http://localhost:4318
SERVICE_NAME=backend-service
OBS_AUTH_TOKEN=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=backend-service

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=60/minute
